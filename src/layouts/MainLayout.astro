---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  hideFooter?: boolean;
}

const {
  title,
  description = 'Security engineering leader building production-grade automation, PAM architecture, and agentic AI systems.',
  ogType = 'website',
  hideFooter = false
} = Astro.props;

const siteRoot = Astro.site ?? new URL('https://adamsneed.com');
const canonicalUrl = new URL(Astro.url.pathname, siteRoot).toString();
const pageTitle = title.includes('Adam Sneed') ? title : `${title} | Adam Sneed`;
const ogImage = new URL('/og-image.svg', siteRoot).toString();
const path = Astro.url.pathname;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/arcade', label: 'Arcade' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' }
];

const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Adam Sneed',
  url: siteRoot.toString(),
  inLanguage: 'en',
  publisher: {
    '@type': 'Person',
    name: 'Adam Lacroix Sneed'
  }
};

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Adam Lacroix Sneed',
  url: 'https://adamsneed.com',
  jobTitle: 'Security-focused Engineering Leader',
  image: new URL('/og-image.svg', siteRoot).toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Austin',
    addressRegion: 'TX',
    addressCountry: 'US'
  },
  sameAs: ['https://www.linkedin.com/in/adam-sneed-8113375/', 'https://github.com/adamlsneed'],
  email: 'adam@adamsneed.com'
};

const pageJsonLd = {
  '@context': 'https://schema.org',
  '@type': ogType === 'article' ? 'Article' : 'WebPage',
  name: pageTitle,
  url: canonicalUrl,
  isPartOf: {
    '@type': 'WebSite',
    url: siteRoot.toString(),
    name: 'Adam Sneed'
  },
  author: {
    '@type': 'Person',
    name: personJsonLd.name,
    url: personJsonLd.url
  },
  description
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#090d14" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Adam Sneed — Security Engineering & Agentic Systems" />
    <meta property="og:site_name" content="Adam Sneed" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Adam Sneed — Security Engineering & Agentic Systems" />

    <script type="application/ld+json" set:html={JSON.stringify([websiteJsonLd, personJsonLd, pageJsonLd])}></script>

    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "aacd26d2d0f44131a55f4f97ddad5110"}'></script>
  </head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>

    <!-- Particle Network Canvas -->
    <canvas id="particle-canvas" class="pointer-events-none fixed inset-0" style="z-index:0" aria-hidden="true"></canvas>

    <!-- Navigation -->
    <header class="fixed left-0 right-0 top-0 z-50">
      <div class="mx-auto max-w-6xl px-6 py-4 backdrop-blur-xl backdrop-saturate-150">
        <nav class="flex items-center justify-between" aria-label="Primary">
          <a href="/" class="font-mono text-[12px] tracking-[0.12em] text-textMuted/70 transition-colors duration-300 hover:text-accent">
            adam sneed
          </a>

          <!-- Desktop -->
          <ul class="hidden items-center gap-5 md:flex">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'font-mono text-[11px] tracking-[0.1em] uppercase transition-colors duration-300',
                      isActive(item.href)
                        ? 'text-accent'
                        : 'text-textMuted/50 hover:text-textMuted'
                    ]}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>

          <!-- Mobile Toggle -->
          <button
            id="mobile-toggle"
            class="p-2 text-textMuted transition-colors hover:text-textMain md:hidden"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <svg id="icon-menu" class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
            <svg id="icon-close" class="hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </nav>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="overflow-hidden md:hidden" style="max-height:0;opacity:0;transition:max-height 0.4s cubic-bezier(0.16,1,0.3,1),opacity 0.3s ease">
        <div class="px-6 pb-6 pt-2 backdrop-blur-xl backdrop-saturate-150">
          <ul class="flex flex-col gap-1">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'mobile-nav-link block rounded-lg px-4 py-3 font-mono text-[12px] tracking-[0.1em] uppercase transition-colors duration-300',
                      isActive(item.href)
                        ? 'bg-accent/5 text-accent'
                        : 'text-textMuted/60 hover:bg-panel/50 hover:text-textMuted'
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </header>

    <main id="main-content" class="relative flex-1" style="z-index:1">
      <slot />
    </main>

    {!hideFooter && (
      <footer class="relative border-t border-borderTone/70 px-6 py-16" style="z-index:1">
        <div class="mx-auto max-w-6xl">
          <div data-reveal class="flex flex-col items-center justify-between gap-6 md:flex-row">
            <p class="text-sm font-mono text-textMuted">Adam Sneed &copy; {new Date().getFullYear()}</p>
            <nav aria-label="Footer">
              <ul class="flex items-center gap-8">
                <li><a href="https://www.linkedin.com/in/adam-sneed-8113375/" target="_blank" rel="noreferrer" class="text-sm text-textMuted transition-colors duration-300 hover:text-accent">LinkedIn</a></li>
                <li><a href="https://github.com/adamlsneed" target="_blank" rel="noreferrer" class="text-sm text-textMuted transition-colors duration-300 hover:text-accent">GitHub</a></li>
                <li><a href="mailto:adam@adamsneed.com" class="text-sm text-textMuted transition-colors duration-300 hover:text-accent">Email</a></li>
              </ul>
            </nav>
          </div>
        </div>
      </footer>
    )}

    <script>
      // Mobile nav toggle
      const toggle = document.getElementById('mobile-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconMenu = document.getElementById('icon-menu');
      const iconClose = document.getElementById('icon-close');
      let mobileOpen = false;

      toggle?.addEventListener('click', () => {
        mobileOpen = !mobileOpen;
        if (menu) {
          menu.style.maxHeight = mobileOpen ? '400px' : '0px';
          menu.style.opacity = mobileOpen ? '1' : '0';
        }
        iconMenu?.classList.toggle('hidden', mobileOpen);
        iconClose?.classList.toggle('hidden', !mobileOpen);
        toggle.setAttribute('aria-expanded', String(mobileOpen));
        toggle.setAttribute('aria-label', mobileOpen ? 'Close menu' : 'Open menu');
      });

      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', () => {
          mobileOpen = false;
          if (menu) { menu.style.maxHeight = '0px'; menu.style.opacity = '0'; }
          iconMenu?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
        });
      });

      // Scroll reveal (IntersectionObserver)
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                const delay = el.dataset.revealDelay;
                if (delay) {
                  el.style.transitionDelay = delay + 'ms';
                }
                el.classList.add('is-visible');
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -50px 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      }

      // Particle network
      (function() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        const particleColors = [
          [0, 255, 220],    // bright teal/cyan
          [50, 200, 255],   // vivid blue
          [180, 130, 255],  // vivid purple
          [255, 100, 150],  // hot pink
          [255, 200, 50],   // warm amber
        ];

        interface Particle {
          x: number; y: number; vx: number; vy: number; radius: number; opacity: number;
          color: number[];
        }

        let particles: Particle[] = [];
        const mouse = { x: -1000, y: -1000 };

        function initParticles() {
          const count = Math.floor((canvas.width * canvas.height) / 15000);
          particles = [];
          for (let i = 0; i < count; i++) {
            particles.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,
              vx: (Math.random() - 0.5) * 0.4,
              vy: (Math.random() - 0.5) * 0.4,
              radius: Math.random() * 1.5 + 0.5,
              opacity: Math.random() * 0.5 + 0.2,
              color: particleColors[Math.floor(Math.random() * particleColors.length)],
            });
          }
        }

        function resize() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
          initParticles();
        }

        resize();
        window.addEventListener('resize', resize);
        window.addEventListener('mousemove', (e) => { mouse.x = e.clientX; mouse.y = e.clientY; });

        // Click explosions
        interface Spark {
          x: number; y: number; vx: number; vy: number;
          color: number[]; life: number; maxLife: number; radius: number;
        }
        const sparks: Spark[] = [];

        canvas.style.pointerEvents = 'none';
        document.addEventListener('click', (e) => {
          // Don't fire on interactive elements
          const target = e.target as HTMLElement;
          if (target.closest('a, button, input, textarea, select, [role="button"], aside, .card')) return;

          const count = 12 + Math.floor(Math.random() * 8);
          for (let i = 0; i < count; i++) {
            const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.5;
            const speed = 1.5 + Math.random() * 3;
            sparks.push({
              x: e.clientX,
              y: e.clientY,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed,
              color: particleColors[Math.floor(Math.random() * particleColors.length)],
              life: 1,
              maxLife: 40 + Math.random() * 30,
              radius: 1 + Math.random() * 2,
            });
          }
        });

        function animate() {
          if (!ctx) return;
          // Trail effect: semi-transparent overlay instead of full clear
          ctx.fillStyle = 'rgba(9, 13, 20, 0.15)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          for (const p of particles) {
            p.x += p.vx;
            p.y += p.vy;
            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

            const dx = p.x - mouse.x;
            const dy = p.y - mouse.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 150) {
              const force = (150 - dist) / 150;
              p.vx += (dx / dist) * force * 0.2;
              p.vy += (dy / dist) * force * 0.2;
            }
            p.vx *= 0.99;
            p.vy *= 0.99;

            const [r, g, b] = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${p.opacity})`;
            ctx.fill();
          }

          for (let i = 0; i < particles.length; i++) {
            for (let j = i + 1; j < particles.length; j++) {
              const dx = particles[i].x - particles[j].x;
              const dy = particles[i].y - particles[j].y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 120) {
                const opacity = (1 - dist / 120) * 0.15;
                // Blend the two particle colors for the connection line
                const c1 = particles[i].color;
                const c2 = particles[j].color;
                const mr = (c1[0] + c2[0]) >> 1;
                const mg = (c1[1] + c2[1]) >> 1;
                const mb = (c1[2] + c2[2]) >> 1;
                ctx.beginPath();
                ctx.moveTo(particles[i].x, particles[i].y);
                ctx.lineTo(particles[j].x, particles[j].y);
                ctx.strokeStyle = `rgba(${mr}, ${mg}, ${mb}, ${opacity})`;
                ctx.lineWidth = 0.5;
                ctx.stroke();
              }
            }
          }

          for (const p of particles) {
            const dx = p.x - mouse.x;
            const dy = p.y - mouse.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 200) {
              const opacity = (1 - dist / 200) * 0.3;
              const [r, g, b] = p.color;
              ctx.beginPath();
              ctx.moveTo(p.x, p.y);
              ctx.lineTo(mouse.x, mouse.y);
              ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${opacity})`;
              ctx.lineWidth = 0.8;
              ctx.stroke();
            }
          }

          // Render click sparks
          for (let i = sparks.length - 1; i >= 0; i--) {
            const s = sparks[i];
            s.x += s.vx;
            s.y += s.vy;
            s.vx *= 0.97;
            s.vy *= 0.97;
            s.life += 1;
            const fade = 1 - s.life / s.maxLife;
            if (fade <= 0) {
              sparks.splice(i, 1);
              continue;
            }
            const [r, g, b] = s.color;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.radius * fade, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${fade * 0.8})`;
            ctx.fill();
          }

          requestAnimationFrame(animate);
        }

        animate();
      })();
    </script>
  </body>
</html>
