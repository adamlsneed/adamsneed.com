---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Arcade"
  description="Play classic games over SSH or in your browser. No install, no signup."
>
  <!-- Hero -->
  <section class="px-6 pb-16 pt-32">
    <div class="mx-auto max-w-3xl">
      <div data-reveal>
        <span class="text-xs font-mono uppercase tracking-[0.3em] text-textMuted">Projects</span>
        <h1 class="mt-4 text-balance text-4xl font-bold leading-tight text-textMain md:text-6xl">Arcade</h1>
        <p class="mt-6 text-pretty text-lg leading-relaxed text-textMuted">
          Classic games — play from your terminal over SSH or right here in the browser.
        </p>
      </div>
    </div>
  </section>

  <!-- SSH Arcade -->
  <section class="px-6 pb-20">
    <div class="mx-auto max-w-3xl">
      <div data-reveal data-reveal-delay="100">
        <h2 class="mb-6 text-2xl font-bold text-textMain md:text-3xl">
          <span class="mr-2">🖥️</span>Terminal Games
        </h2>
        <p class="mb-6 text-textMuted">
          One command, multiple games. Connect from any terminal — pick your game from the menu.
          Built with Go, <a href="https://charm.sh" target="_blank" rel="noreferrer" class="text-accent hover:underline">Charm</a>, and raw ANSI escape codes.
        </p>

        <!-- Terminal -->
        <div class="card overflow-hidden mb-8">
          <div class="bg-panel/50 px-4 py-2.5 border-b border-borderTone/50">
            <div class="flex items-center gap-[7px]">
              <span class="h-[10px] w-[10px] rounded-full bg-[#ff5f57]/60"></span>
              <span class="h-[10px] w-[10px] rounded-full bg-[#febc2e]/60"></span>
              <span class="h-[10px] w-[10px] rounded-full bg-[#28c840]/60"></span>
              <span class="ml-3 font-mono text-[11px] text-textMuted/50">terminal</span>
            </div>
          </div>
          <div class="px-5 py-4 font-mono text-sm flex items-center justify-between gap-3">
            <div>
              <p class="text-textMuted/50">$ <span class="text-accent">ssh</span> <span class="text-textMain">arcade.adamsneed.com</span></p>
              <p class="mt-1 text-textMuted/40"># Pick a game. No install, no signup.</p>
            </div>
            <button
              class="copy-btn flex-shrink-0 rounded-lg border border-borderTone/50 bg-panel/50 p-2.5 text-textMuted transition-all duration-200 hover:border-accent/50 hover:text-accent"
              data-copy="ssh arcade.adamsneed.com"
              aria-label="Copy SSH arcade command"
            >
              <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            </button>
          </div>
        </div>

        <!-- Game list -->
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="card p-5">
            <h3 class="text-lg font-bold text-textMain"><span class="mr-2">🧱</span>Tetris</h3>
            <p class="mt-2 text-sm text-textMuted">SRS rotation, ghost piece, hold queue, next-3 preview, wall kicks, level scaling. Full leaderboard.</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              <span class="rounded-full border border-borderTone/50 bg-panel/30 px-2.5 py-0.5 text-[11px] font-mono text-textMuted">SRS rotation</span>
              <span class="rounded-full border border-borderTone/50 bg-panel/30 px-2.5 py-0.5 text-[11px] font-mono text-textMuted">Ghost piece</span>
              <span class="rounded-full border border-borderTone/50 bg-panel/30 px-2.5 py-0.5 text-[11px] font-mono text-textMuted">Leaderboard</span>
            </div>
          </div>
          <div class="card p-5">
            <h3 class="text-lg font-bold text-textMain"><span class="mr-2">🐍</span>Snake</h3>
            <p class="mt-2 text-sm text-textMuted">Classic snake with speed scaling per level. Arrow keys or WASD. Compete on the global leaderboard.</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              <span class="rounded-full border border-borderTone/50 bg-panel/30 px-2.5 py-0.5 text-[11px] font-mono text-textMuted">WASD + arrows</span>
              <span class="rounded-full border border-borderTone/50 bg-panel/30 px-2.5 py-0.5 text-[11px] font-mono text-textMuted">Speed scaling</span>
              <span class="rounded-full border border-borderTone/50 bg-panel/30 px-2.5 py-0.5 text-[11px] font-mono text-textMuted">Leaderboard</span>
            </div>
          </div>
        </div>

        <!-- Source -->
        <div class="mt-4 flex items-center gap-4">
          <a href="https://github.com/adamlsneed/ssh-arcade" target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-xs font-mono text-textMuted/50 transition-colors duration-200 hover:text-accent">
            <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
            View source
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="mx-auto max-w-3xl px-6">
    <hr class="border-borderTone/30" />
  </div>

  <!-- Browser Games -->
  <section class="px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <div data-reveal data-reveal-delay="200">
        <h2 class="mb-6 text-2xl font-bold text-textMain md:text-3xl">
          <span class="mr-2">🌐</span>Browser Games
        </h2>
        <p class="mb-6 text-textMuted">
          No terminal? Play right here.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          <a href="/game" class="card p-5 group transition-all duration-200 hover:border-accent/40 block">
            <h3 class="text-lg font-bold text-textMain group-hover:text-accent transition-colors">
              <span class="mr-2">🧱</span>Tetris
            </h3>
            <p class="mt-2 text-sm text-textMuted">Full-featured Tetris with Canvas rendering, T-spin detection, touch controls, and local high scores.</p>
            <p class="mt-3 text-xs font-mono text-accent opacity-0 group-hover:opacity-100 transition-opacity">Play now →</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- How it's built -->
  <section class="px-6 pb-32">
    <div class="mx-auto max-w-3xl">
      <div data-reveal data-reveal-delay="300">
        <div class="border-l-2 border-accent/30 pl-6">
          <h2 class="mb-4 text-2xl font-bold text-textMain md:text-3xl">How it's built</h2>
          <div class="space-y-3 text-textMuted">
            <p class="text-pretty">
              The SSH arcade is a single Go binary using <a href="https://github.com/charmbracelet/wish" target="_blank" rel="noreferrer" class="text-accent hover:underline">Wish</a> and <a href="https://github.com/charmbracelet/bubbletea" target="_blank" rel="noreferrer" class="text-accent hover:underline">Bubble Tea</a>. Colors are raw ANSI escape codes (lipgloss color detection fails over SSH). Scores persist in WAL-mode SQLite via <code class="rounded bg-panel/50 px-1.5 py-0.5 text-xs font-mono text-textMuted">modernc.org/sqlite</code> &mdash; pure Go, no CGO.
            </p>
            <p class="text-pretty">
              Identity is tied to your SSH key fingerprint &mdash; your name and scores follow you across sessions. No account needed.
            </p>
            <p class="text-pretty">
              The browser Tetris is vanilla JavaScript + Canvas &mdash; no frameworks, no dependencies.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = (btn as HTMLElement).dataset.copy;
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const svg = btn.querySelector('svg');
          if (svg) {
            const original = svg.innerHTML;
            svg.innerHTML = '<polyline points="20 6 9 17 4 12"/>';
            setTimeout(() => { svg.innerHTML = original; }, 1500);
          }
        } catch {}
      });
    });
  </script>
</MainLayout>
